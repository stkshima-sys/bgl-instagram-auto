# ===== OpenAI（企画・文章・画像生成） =====
OPENAI_API_KEY=sk-xxxx

# ===== Instagram Graph API =====
# ⚠️ Baseball Girls LIFE 専用アカウント（@baseball_girls_life）のトークン。
# Draft公式アカウントのものと混同しないこと。
# Meta for Developers でアプリ作成 → Instagramビジネスアカウントを
# Facebookページに接続 → 長期アクセストークンを発行（セットアップ手順.md参照）
INSTAGRAM_ACCESS_TOKEN=EAAxxxx
INSTAGRAM_BUSINESS_ACCOUNT_ID=1784xxxxxxxxxxx
FACEBOOK_PAGE_ID=1xxxxxxxxxxxxxx

# ===== Google Sheets =====
# BGL専用の新規スプレッドシートを作成すること（Draft公式のシートと分ける）
GOOGLE_SHEETS_ID=1AbCdEfGhIjKlMn
# サービスアカウントJSONのパス、またはJSON文字列そのもの（GitHub Actionsでは文字列を推奨）
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# ===== メディア公開URL =====
# Instagram APIは「公開URL」からしか画像/動画を取得できない。
# このリポジトリ(public)のrawURLを使う。 例:
# https://raw.githubusercontent.com/<ユーザー名>/bgl-instagram-auto/main
MEDIA_BASE_URL=https://raw.githubusercontent.com/your-name/bgl-instagram-auto/main

# ===== 動画生成（任意・完全自動化する場合） =====
# Replicate経由でKling/Veoを呼ぶ。未設定なら「英語プロンプト生成→手動で動画作成」運用。
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=kwaivgi/kling-v2.1

# ===== サイトURL（CTA用） =====
# Draft流入を計測できるようUTMパラメータ付きを推奨
DRAFT_URL=https://draft-match.com/?utm_source=instagram&utm_medium=bgl
